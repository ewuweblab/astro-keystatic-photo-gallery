---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/">Photo Gallery</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
  }
  body {
    margin: 0 auto;
    max-width: 72rem;
    padding: 1.5rem 1rem;
  }
  header a {
    font-weight: 600;
    text-decoration: none;
    color: inherit;
  }
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  .grid a {
    color: inherit;
    text-decoration: none;
  }
  figure {
    margin: 0;
  }
  figcaption {
    font-size: 0.9rem;
    opacity: 0.75;
    padding-top: 0.35rem;
  }
</style>
